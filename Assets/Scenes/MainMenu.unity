      m_Calls: []
  m_text: "5.<indent=8%><b>The Usher ('The Candleman')</b>\nOur automated guide patrols
    the halls to collect balances:\n\u2022 <b>Sufficient Coins:</b> Debt cleared
    to 0 (+1 Settled Receipt).\n\u2022 <b>Insufficient Coins:</b> Account defaulted!
    You lose 1 Life (out of 3), and your payment streak resets to 0/3.</indent>"
  m_isRightToLeft: 0
